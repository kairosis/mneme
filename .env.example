# RabbitMQ
RABBITMQ_URL=amqp://kairosis:<password>@localhost:5672
RABBITMQ_EXCHANGE=kairosis.topic

# Qdrant
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=mneme

# Embedding (Vercel AI SDK)
EMBEDDING_PROVIDER=ollama        # ollama | openai
EMBEDDING_MODEL=nomic-embed-text
OLLAMA_BASE_URL=http://localhost:11434/v1

# OpenAI (only needed if EMBEDDING_PROVIDER=openai)
# OPENAI_API_KEY=

# Server
SERVER_PORT=3000

# Web
NEXT_PUBLIC_API_URL=http://localhost:3000
WEB_PORT=3001
